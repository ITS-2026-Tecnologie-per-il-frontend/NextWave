# Copiare in .env.local e compilare URL e chiave pubblica Supabase. La demo è disattivata.
VITE_DATA_MODE=supabase
# Destinazione pubblica delle email di conferma, anche durante le prove locali.
VITE_SITE_URL=https://next-wave-iota.vercel.app/
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Solo server Vercel e strumenti amministrativi locali. Mai aggiungere VITE_ a queste chiavi.
SUPABASE_SERVICE_ROLE_KEY=
