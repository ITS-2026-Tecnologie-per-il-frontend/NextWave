{
  "name": "vibe-pulse",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-spot-auth.mjs",
    "prebuild": "node scripts/patch-spot-auth.mjs",
    "start": "vite --host 127.0.0.1 --port 4173",
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "format": "prettier --write src tests scripts index.html vite.config.js package.json README.md docs",
    "format:check": "prettier --check src tests scripts index.html vite.config.js package.json README.md docs",
    "db:bundle": "node scripts/build-database.mjs",
    "db:test": "node scripts/test-database.mjs",
    "db:check": "node --env-file=.env.local scripts/check-supabase.mjs",
    "db:link": "supabase link --project-ref xitmtulynclfozfsbhfz",
    "db:push": "supabase db push",
    "db:start": "supabase start"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "spot-auth": "^0.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "supabase": "^2.119.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
