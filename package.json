{
  "name": "next-wave",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 4173",
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:responsive": "playwright test --config tests/responsive/playwright.config.ts --project chromium --project webkit --project mobile-touch",
    "test:responsive:all": "playwright test --config tests/responsive/playwright.config.ts",
    "format": "prettier --write src server api tests scripts index.html vite.config.ts package.json README.md docs vercel.json tsconfig.json",
    "format:check": "prettier --check src server api tests scripts index.html vite.config.ts package.json README.md docs vercel.json tsconfig.json",
    "db:bundle": "tsx scripts/database/build-database.mjs",
    "db:test": "node tests/database/test-database.mjs",
    "admin:test": "node tests/database/test-admin.mjs",
    "admin:links:test": "node tests/database/test-admin-links.mjs",
    "admin:avatars:test": "node tests/database/test-admin-avatars.mjs",
    "artist:test": "node tests/database/test-artist.mjs",
    "contests:test": "node tests/database/test-real-contests.mjs",
    "selection:test": "node tests/database/test-small-contest.mjs",
    "queue:test": "node tests/database/test-genre-queue.mjs",
    "balance:test": "node tests/database/test-balanced-selection.mjs",
    "db:check": "node --env-file=.env.local scripts/database/check-supabase.mjs",
    "audio:admin": "node --env-file=.env.local --env-file-if-exists=.env.audio.local scripts/audio/audio-admin.mjs",
    "audio:upload-demo": "npm run audio:admin -- upload-demo",
    "db:link": "supabase link --project-ref xitmtulynclfozfsbhfz",
    "db:push": "supabase db push",
    "db:start": "supabase start",
    "audit:structure": "node scripts/quality/audit-project.mjs",
    "check": "npm run audit:structure && npm run typecheck && npm run format:check && npm test",
    "typecheck": "tsc --noEmit",
    "superadmins:test": "node tests/database/test-superadmins.mjs",
    "favorites:test": "node tests/database/test-contest-favorites.mjs",
    "preferences:test": "node tests/database/test-live-preferences.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "music-metadata": "^12.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "supabase": "^2.119.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
